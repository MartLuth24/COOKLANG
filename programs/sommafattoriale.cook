// Calcolo dei primi N fattoriali e ricerca del valore massimo
procedure: {
    Int N = 8;

    Int[] fact = new Int[N];
    fact[0] = 1; // 0! = 1

    // Calcolo iterativo dei fattoriali: n! = n * (n-1)!
    Int i = 1;
    while (i < N) {
        fact[i] = fact[i - 1] * i;
        i++;
    }

    print i"Calcolo dei primi ${N} fattoriali:";
    for j from 0 to N - 1 {
        print i"${j}! = ${fact[j]}";
    }

    // Scoping: blocco isolato per calcoli statistici
    {
        Int sommaFattoriali = 0;
        Int pariCount = 0;

        for k from 0 to N - 1 {
            sommaFattoriali += fact[k];
            
            // Verifica se il fattoriale è pari
            if (fact[k] % 2 == 0) {
                pariCount++;
            }
        }

        print i"Somma totale dei fattoriali: ${sommaFattoriali}";
        print i"Numero di valori pari trovati: ${pariCount}";
    }
    // Qui 'sommaFattoriali' e 'pariCount' non sono più accessibili
}