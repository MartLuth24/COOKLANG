procedure: {
    Int contatore = 1;
    contatore++;      // Incremento unitario (contatore = 2)
    contatore += 3;    // Assegnamento composto (contatore = 5)

    // Operatore ternario per scelta condizionale di valori/stringhe
    String stato = (contatore >= 5) ? "Raggiunto" : "In corso";

    print i"Valore finale: ${contatore} - Stato: ${stato}";
}

// Valore finale: 5 - Stato: Raggiunto